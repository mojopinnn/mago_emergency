# MAGO Emergency — 로컬/서버 비밀 설정 (이 파일을 복사해 .env 로 저장하세요)
#   PowerShell: Copy-Item .env.example .env
# git에는 .env 를 올리지 마세요.

SHOTGRID_URL=https://studiomago.shotgrid.autodesk.com
SHOTGRID_SCRIPT_NAME=your_script_name_here
SHOTGRID_API_KEY=your_api_key_here

# 최근 처리 내역에 「이름 + 파트」(예: 홍길동 comp) 표시 시 HumanUser 필드 코드.
# 스튜디오에 맞게 지정(기본 sg_discipline). 다른 예: department, sg_department, sg_team
# SHOTGRID_USER_PART_FIELD=sg_discipline

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# python main.py / dev.ps1 사용 시 (uvicorn 직접 실행 시 --port 가 우선)
PORT=8000

# 선택: Cloudflare Worker 대기열
# CF_WORKER_URL=
# RELAY_SECRET=

# 선택: /admin/links 등에서 쓰는 공개 베이스 URL
# PUBLIC_BASE_URL=https://your-host.example.com

# ── 긴급 참조(CC) 알림 수신자 (이 Python 서버 버전)
#
# 운영 정책: CC는 ShotGrid Group ``emer_cc``(파트 실장 등)만 사용합니다.
# (PM 자동 CC는 사용하지 않음 — PM은 대개 AMI 실행자이므로 회신 대상에 포함됩니다.)
#
# MAGO_CC_GROUP_CODE=emer_cc

# ── AMI 실행자(긴급 발송한 사람): 확인/응답 회신 푸시 수신 자
#
# 레코드에 HumanUser.id 가 있어야 회신 알림을 받습니다. ShotGrid AMI 설정에서 다음 중 하나를
# 웹훅 폼에 넘기도록 하세요(키 이름 예시).
#   - user_id 또는 current_user_id 등 정수 필드(스크립트/표현식으로 ``Current User``.id 등)
#   - 또는 user_login 과 함께 서버가 ShotGrid 에서 로그인으로 HumanUser 검색해 id 복구
# 기존처럼 ``user_name`` 만 있어도 CC(실장) 참조에는 영향 없고, 회신만 실행자가 스킵될 수 있습니다.
#
# ── Version AMI (Action Menu 에서 entity_type = Version 일 때)
#
# 알림 본문(수정 피드백)은 기본으로 ShotGrid 「Note」 엔티티만 사용합니다.
# (버전 화면에 붙인 코멘트 / Notes 탭 — note_links 로 Version 과 연결, created_at 최신 1건)
#
# Note 가 없거나 비어 있을 때만, Version 레코드의 **단일 텍스트 필드**를 읽습니다.
# (기본값 아님 — 필요할 때만 API 필드 코드를 적습니다. 구버전 변수 SHOTGRID_VERSION_NOTE_FIELD 로도 같은 용도 지원)
# SHOTGRID_VERSION_FEEDBACK_FALLBACK_FIELD=sg_review_notes

# Version.Task 링크 vs Task.Versions 링크 (양방향이라 코드가 서로 다름 — 정상)
#   Version 엔티티 → 필드 Task → API 코드 보통 sg_task   (단일 태스크를 가리킴)
#   Task 엔티티   → 필드 Versions → API 코드 보통 sg_versions (그 태스크에 매달린 여러 버전)
# AMI 가 Version 을 선택해 오므로 우리 코드는 항상 **Version 레코드**에서 sg_task 등을 읽는다(Task 의 sg_versions 아님).
#
# UI 의 Task 컬럼 = 위 Version.sg_task 와 동일할 때가 많음(보통 sg_task). 레거시·커스텀은 코드가 다를 수 있음.
# 필요 시 Fields 화면의 Field Code 를 쉼표로 적으면 됨(앞이 우선). 미설정 시 sg_task 다음 task 순으로 시도.
# SHOTGRID_VERSION_TASK_FIELDS=sg_task,task
